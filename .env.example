# GCP プロジェクト(未設定時は ADC から自動解決される)
GOOGLE_CLOUD_PROJECT=your-project-id

# Firestore の named database(既定: sre-agents / asia-northeast1)
FIRESTORE_DATABASE=sre-agents

# GCP障害シナリオ(store-app / Cloud Run)のサンドボックスプロジェクト。
# 設定すると調査エージェントに Gemini Cloud Assist(リモートMCP)の
# 調査ツール(investigate_issue / ask_cloud_assist)が追加される。
# 未設定なら従来のモック3システムのみ(eval / CI は未設定で実行する)。
# SANDBOX_PROJECT_ID=your-sandbox-project-id
