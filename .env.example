# GCP プロジェクト(未設定時は ADC から自動解決される)
GOOGLE_CLOUD_PROJECT=your-project-id

# Firestore の named database(既定: sre-agents / asia-northeast1)
FIRESTORE_DATABASE=sre-agents

# GCP障害シナリオ(store-app / Cloud Run、store-web-fleet / GCE)の
# サンドボックスプロジェクト。設定すると調査エージェントに
# Gemini Cloud Assist(リモートMCP)と BigQuery ログ検索
# (query_incident_bigquery_logs)の調査ツールが追加され、
# store-web-fleet の restart_server は対象インスタンスを実リセットする。
# 未設定なら GCP調査ツールなし・復旧は全てモック(eval / CI は未設定で実行する)。
# SANDBOX_PROJECT_ID=your-sandbox-project-id
